{
  "name": "geeboard-daemon",
  "version": "0.10.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "Node agent: drives game server containers and reports their state to the panel.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "join": "tsx src/join.ts",
    "terminal": "tsx src/terminal-switch.ts",
    "pin-ca": "tsx src/panel-ca.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsx --test test/*.test.ts",
    "test:unit": "node scripts/unit.mjs"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "ws": "^8.19.0"
  },
  "optionalDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.13.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@homebridge/node-pty-prebuilt-multiarch": true,
    "esbuild": true,
    "protobufjs": true,
    "ssh2": true
  }
}
