# Seeded design canvas — a ~4 MB build artifact produced by
# `node design-canvas/build.mjs` + the Claude Design seed helper.
# The artboards and canvas.json it is built from are tracked.
design-canvas/geeboard-panel.html

# Dependencies
node_modules/

# Build output
.next/
dist/
build/

# The documentation site, built from docs/ by docs-src/build.mjs and
# published by .github/workflows/docs.yml. It is never committed: docs/ is
# the source, and generated HTML in a diff hides the one line that changed.
site/

# Environment
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code skills (local, not shared)
.claude/
