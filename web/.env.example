# Do not fill this in by hand: `npm run setup:env` writes .env from it with
# generated secrets, and refuses to touch one that already exists.
#
# The two secrets are empty on purpose. They used to hold a sentence that
# was thirty-six characters long — enough to pass the length check — so a
# panel following its own README signed sessions with a value printed in
# a public repository. The panel now refuses a missing, short or
# example-looking secret, in production at start-up.

# Development: the Postgres from docker-compose.yml. Production: its own
# user and password — the panel refuses `geeboard:geeboard` in production.
DATABASE_URL="postgresql://geeboard:geeboard@localhost:5432/geeboard?schema=public"

# Signs session cookies. At least 32 random characters.
SESSION_SECRET=""

# Encrypts node agent tokens and the off-site bucket's keys at rest. At
# least 32 random characters, and not the same as SESSION_SECRET. Changing
# it makes every stored node token undecryptable: re-register the nodes,
# or do not change it.
SECRETS_KEY=""

# Where node agents and browsers reach this panel, e.g. https://panel.example.com.
# Used in the Add a node command. Optional in development.
# PANEL_URL="https://panel.example.com"

# A Steam Web API key, which is only what searching the Steam Workshop needs:
# the Mods tab on a Project Zomboid server. Without one the tab still adds a
# mod by its Workshop link or id, which asks Steam nothing that needs a key.
# Make one at https://steamcommunity.com/dev/apikey — the domain it asks for
# is a label Steam neither checks nor enforces. Treat the key as a secret: it
# belongs to a Steam account.
# STEAM_API_KEY=""
