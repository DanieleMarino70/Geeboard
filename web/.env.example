DATABASE_URL="postgresql://geeboard:geeboard@localhost:5432/geeboard?schema=public"
SESSION_SECRET="generate-with-openssl-rand-base64-32"
# Where node agents reach this panel, used in the Add a node command.
# Optional: without it the address the browser used is offered instead.
# PANEL_URL="https://panel.example.com"
# Encrypts node agent tokens at rest. Falls back to SESSION_SECRET if unset.
SECRETS_KEY="generate-with-openssl-rand-base64-32"
