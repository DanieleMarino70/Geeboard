{
  "name": "web",
  "version": "0.8.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "setup:env": "tsx scripts/setup-env.mts",
    "setup": "tsx --conditions=react-server scripts/setup.mts",
    "admin:recover": "tsx --conditions=react-server scripts/admin-recover.mts",
    "rekey": "tsx --conditions=react-server scripts/rekey.mts",
    "manifest:check": "tsx scripts/check-manifest.mts",
    "node-token": "tsx --conditions=react-server scripts/node-token.mts",
    "db:deploy": "prisma migrate deploy",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:migrate": "tsx scripts/guard-db.mts migrate && prisma migrate dev && prisma generate",
    "db:seed": "tsx scripts/guard-db.mts seed && prisma db seed",
    "db:seed:empty": "tsx scripts/guard-db.mts seed && prisma db seed -- --empty",
    "db:studio": "prisma studio",
    "db:reset": "tsx scripts/guard-db.mts reset && prisma migrate reset --force && prisma generate",
    "verify:authorize": "tsx --conditions=react-server scripts/verify-authorize.mts",
    "verify:upgrade": "tsx --conditions=react-server scripts/verify-upgrade.mts",
    "verify:ops": "tsx --conditions=react-server scripts/verify-ops.mts",
    "verify:cron": "tsx scripts/verify-cron.mts",
    "verify:schedule": "tsx --conditions=react-server scripts/verify-schedule.mts",
    "verify": "tsx scripts/verify-all.mts",
    "verify:api": "tsx --conditions=react-server scripts/verify-api.mts",
    "verify:settings": "tsx --conditions=react-server scripts/verify-settings.mts",
    "verify:members": "tsx --conditions=react-server scripts/verify-members.mts",
    "verify:apikeys": "tsx --conditions=react-server scripts/verify-apikeys.mts",
    "verify:hardening": "tsx --conditions=react-server scripts/verify-hardening.mts",
    "verify:agent": "tsx --conditions=react-server scripts/verify-agent.mts",
    "verify:all": "tsx scripts/verify-all.mts --all",
    "verify:registration": "tsx --conditions=react-server scripts/verify-registration.mts",
    "verify:console": "tsx --conditions=react-server scripts/verify-console.mts",
    "verify:terminal": "tsx --conditions=react-server scripts/verify-terminal.mts",
    "verify:dns": "tsx --conditions=react-server scripts/verify-dns.mts",
    "verify:hosts": "tsx --conditions=react-server scripts/verify-hosts.mts",
    "verify:rekey": "tsx --conditions=react-server scripts/verify-rekey.mts",
    "verify:storage": "tsx --conditions=react-server scripts/verify-storage.mts",
    "verify:notify": "tsx --conditions=react-server scripts/verify-notify.mts",
    "verify:templates": "tsx --conditions=react-server scripts/verify-templates.mts",
    "verify:community": "tsx --conditions=react-server scripts/verify-community.mts",
    "poll": "tsx --conditions=react-server scripts/poller.mts",
    "poll:once": "tsx --conditions=react-server scripts/poller.mts --once",
    "verify:poller": "tsx --conditions=react-server scripts/verify-poller.mts",
    "verify:watchdog": "tsx --conditions=react-server scripts/verify-watchdog.mts",
    "verify:operations": "tsx --conditions=react-server scripts/verify-operations.mts",
    "verify:pollscale": "tsx --conditions=react-server scripts/verify-pollscale.mts",
    "verify:firsthour": "tsx --conditions=react-server scripts/verify-firsthour.mts",
    "verify:extension": "tsx --conditions=react-server scripts/verify-extension.mts",
    "verify:a11y": "tsx --conditions=react-server scripts/verify-a11y.mts",
    "verify:files": "tsx --conditions=react-server scripts/verify-files.mts",
    "verify:create": "tsx --conditions=react-server scripts/verify-create.mts",
    "verify:mods": "tsx --conditions=react-server scripts/verify-mods.mts",
    "verify:pull": "tsx --conditions=react-server scripts/verify-pull.mts",
    "games:sync": "tsx --conditions=react-server scripts/sync-games.mts",
    "test:unit": "tsx --test test/*.test.ts",
    "verify:backups": "tsx --conditions=react-server scripts/verify-backups.mts",
    "verify:catalog": "tsx --conditions=react-server scripts/verify-catalog.mts",
    "verify:setup": "tsx --conditions=react-server scripts/verify-setup.mts",
    "verify:versions": "tsx --conditions=react-server scripts/verify-versions.mts"
