// Geeboard data model.
//
// The domain is: a Game has Versions; a Node is a machine that has been
// registered with the panel; a Server is one game server instance hosted
// on a Node and executed by a Runtime. Those are four different things
// and the schema keeps them that way — nothing here says "container",
// because which runtime a node uses is the node's business.
//
// The catalog tables (Game, GameVersion) are a projection of the game
// definitions in src/domain/games. The definitions are the source of
// truth; these rows exist so servers can point at a version and so the
// catalog can be queried, filtered and joined. `npm run games:sync`
// writes one from the other.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

/// The lifecycle of a game server, which is wider than the lifecycle of
/// whatever is executing it. INSTALLING and UPDATING are states only the
/// panel can know about; a runtime looking at the same server would just
/// see a workload that has not settled. See src/domain/servers/state.ts,
/// where the two views are reconciled.
enum ServerState {
  CREATING
  INSTALLING
  STARTING
  RUNNING
  UNHEALTHY
  STOPPING
  STOPPED
  RESTARTING
  UPDATING
  BACKING_UP
  /// Being moved to another node: stopped, archived off-site, restored there.
  MIGRATING
  DELETING
  CRASHED
  ERROR
  SUSPENDED
}

/// A node's health, and whether it is in service at all.
///
/// PENDING is the one that is not about health: a machine that has
/// registered itself and is waiting for somebody to say yes. Nothing is
/// placed on it and the watchdog leaves it alone until then, because a
/// node that registered with a stolen token must not become useful by
/// simply waiting.
enum NodeState {
  PENDING
  HEALTHY
  DEGRADED
  UNREACHABLE
  DRAINING
  MAINTENANCE
}

/// How a node executes the servers placed on it. One value today; the
/// column exists so that adding a second is a migration and not a
/// rewrite.
enum RuntimeKind {
  DOCKER
}

/// Where a version came from. STATIC is a version shipped in a game
/// definition; the rest are resolved from upstream by a provider.
enum VersionSource {
  STATIC
  STEAM
  GITHUB
  OFFICIAL
  REGISTRY
  MANUAL
}

enum VersionChannel {
  STABLE
  SNAPSHOT
  PREVIEW
  LEGACY
}

/// What to do when a server stops without being asked to.
///
/// Deliberately the panel's decision rather than the runtime's: a
/// container restarting behind the panel's back is the drift
/// reconciliation exists to catch, and a restart nobody can audit is a
/// restart nobody can explain.
enum RestartPolicy {
  NEVER
  ON_FAILURE
  ALWAYS
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
  PRE_UPDATE
}

/// Where a backup's bytes live. Local means the node's own disk, which
/// is the one thing a node failure takes with it — hence the column,
/// so a second backend is a migration rather than a rewrite.
enum BackupStore {
  LOCAL
  S3
}

enum BackupState {
  RUNNING
  COMPLETE
  FAILED
  LOCKED
}

enum TaskKind {
  BACKUP
  RESTART
  BROADCAST
  CLEANUP
  COMMAND
}

enum RunResult {
  SUCCEEDED
  FAILED
  SKIPPED
  NEVER_RUN
}

enum EventTone {
  ACCENT
  INFO
  SUCCESS
  WARNING
  DANGER
  MUTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(MEMBER)
  initials     String    @db.VarChar(2)
  /// Two-factor sign-in is on: a TOTP code is asked for after the password.
  twoFactor    Boolean   @default(false)
  /// The TOTP secret, encrypted at rest like a node token. Set while
  /// enrolment is in progress too, and only counts once twoFactor is on.
  totpSecret   String?
  /// The 30-second step of the last code accepted, so a code is spent once.
  totpLastStep Int?
  /// Null until the person has chosen a password themselves: an account
  /// made from the panel starts with one nobody knows and a setup link.
  passwordSetAt DateTime?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  servers       Server[]  @relation("ServerOwner")
  events        ActivityEvent[]
  apiKeys       ApiKey[]
  accountTokens AccountToken[] @relation("AccountTokenUser")
  issuedTokens  AccountToken[] @relation("AccountTokenIssuer")
  recoveryCodes RecoveryCode[]

  @@map("users")
}

/// Why a one-time link exists: to set the first password, or a new one.
enum AccountTokenPurpose {
  SETUP
  RESET
}

/// A one-time link to set a password. The panel sends no email, so the
/// link is shown once to the admin who made it and handed over by hand;
/// only its SHA-256 is kept. Spent atomically the moment it is used.
model AccountToken {
  id          String              @id @default(cuid())
  userId      String
  purpose     AccountTokenPurpose
  hash        String              @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime            @default(now())

  user      User  @relation("AccountTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AccountTokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("account_tokens")
}

/// A one-time way past two-factor when the authenticator is gone. Shown
/// once at enrolment, stored as SHA-256, each usable once.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  hash      String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/* ── The game catalog ─────────────────────────────────────────────
   A projection of src/domain/games, not a second source of truth. The
   definitions decide what a game is; these rows make it queryable and
   give a server something to point at that will still be there when a
   definition is edited. */

model Game {
  /// Matches the definition's id: "minecraft-java".
  id         String   @id
  name       String
  /// What the panel groups by, and what Server.game has always held.
  family     String
  art        String
  blurb      String
  official   Boolean  @default(false)
  portBase   Int
  portSpan   Int
  /// Node capabilities this game needs before it can be placed.
  requires   String[] @default([])
  memoryGbMin Int     @default(1)
  diskGbMin   Int     @default(1)
  /// Set when a definition is removed but servers still reference it.
  retiredAt  DateTime?
  syncedAt   DateTime @default(now())

  versions GameVersion[]
  servers  Server[]

  @@index([family])
  @@map("games")
}

model GameVersion {
  id      String @id @default(cuid())
  gameId  String
  /// Stable within the game: "paper-1-21-4".
  slug    String
  label   String
  /// The upstream version string, where the game has one: "1.4.4.9".
  upstream String?
  /// What the runtime is asked to run. An image reference today.
  source  String
  note    String @default("")
  channel VersionChannel @default(STABLE)
  origin  VersionSource  @default(STATIC)
  /// Whether Geeboard will install it. A version can be listed and refused.
  supported   Boolean  @default(true)
  recommended Boolean  @default(false)
  releasedAt  DateTime?
  checksum    String?
  /// Steam has no version numbers, only branches and build ids. A build
  /// id is not a version and is never compared against one — it belongs
  /// to its branch and answers a different question: has this moved?
  branch      String?
  buildId     String?
  branchUpdatedAt DateTime?
  syncedAt    DateTime @default(now())

  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  servers Server[]

  @@unique([gameId, slug])
  @@index([gameId, supported])
  @@map("game_versions")
}

model Node {
  id        String    @id @default(cuid())
  name      String    @unique
  city      String
  region    String
  state     NodeState @default(HEALTHY)
  pingMs    Int
  cpuPct    Int
  ramPct    Int
  diskPct   Int
  cpuCores  Int
  ramTotal  Int // GB
  diskTotal Int // GB
  daemon    String
  slots     Int       @default(9)
  /// How this node executes the servers placed on it.
  runtime   RuntimeKind @default(DOCKER)
  /// Reported by the node, not assumed. Null means it has not said yet,
  /// which the compatibility engine treats as unknown rather than wrong.
  os        String?
  arch      String?
  /// What this node can offer: docker, steamcmd, gpu, ipv6, ssd…
  capabilities String[] @default([])
  /// Last time the panel heard from the node at all — a successful poll
  /// or a heartbeat. What node health decays from; see docs/nodes.md.
  lastSeenAt DateTime?
  /// When the node registered itself, and when somebody approved it.
  /// A node with no `approvedAt` takes no servers.
  registeredAt DateTime?
  approvedAt   DateTime?
  approvedById String?
  /// Base URL of the node agent, e.g. http://10.24.8.2:8080. Null means
  /// no agent is attached and lifecycle actions are simulated.
  daemonUrl String?
  /// The agent's bearer token, encrypted at rest. The panel is the
  /// client, so it needs the plaintext back — this cannot be a hash.
  daemonToken String?
  createdAt DateTime  @default(now())

  servers Server[]

  @@map("nodes")
}

/// A single-use invitation for a machine to register itself.
///
/// The secret is shown once and stored as a bcrypt hash, like an API
/// key — a registration token is a credential that can bring a new
/// machine into the fleet, so it is treated like one. Short-lived,
/// single-use and revocable, because the failure mode of a leaked one
/// is somebody else's server appearing in your panel.
model NodeRegistrationToken {
  id        String    @id @default(cuid())
  /// Shown in the UI: gbn_8f2a…d417
  prefix    String
  hash      String
  /// What this token is for: "Milan rack 3".
  label     String
  /// The one node name this token may register. Null only on tokens
  /// minted before names were bound, which accept any name.
  nodeName  String?
  expiresAt DateTime
  /// Set when a node consumes it. A token is good for exactly one node.
  usedAt    DateTime?
  usedByNode String?
  revokedAt DateTime?

  createdById String
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("node_registration_tokens")
}

/// One game server instance. It is hosted on a Node and executed by that
/// node's Runtime — which is why `runtimeId` is opaque here: what it
/// identifies is the runtime's business, and the panel only has to be
/// able to hand it back.
model Server {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  /// The family, kept as text so a server survives its game definition
  /// being renamed or retired. `gameId` is the join; this is the label.
  game        String
  /// The version label, for the same reason.
  version     String
  art         String
  /// The catalog entry this server was created from. Null for servers
  /// that predate the catalog.
  gameId        String?
  gameVersionId String?
  state       ServerState @default(STOPPED)
  playersOn   Int         @default(0)
  playersMax  Int
  cpuPct      Int         @default(0)
  ramPct      Int         @default(0)
  diskPct     Int         @default(0)
  host        String
  port        Int
  memoryLimit Int // GB
  cpuLimit    Int // percent of one core
  diskQuota   Int // GB
  /// How this server is executed, and the runtime's own handle for it.
  /// Opaque on purpose: today it is a container id, and nothing above
  /// the runtime should be written as though it always will be.
  runtime     RuntimeKind @default(DOCKER)
  runtimeId   String?
  /// Game settings, keyed by the definition's config field names —
  /// "maxPlayers", not "MAX_PLAYERS". Rendering them into whatever the
  /// game actually reads is src/domain/games/config.ts's job.
  config      Json?
  /// Why the server is in ERROR, when it is.
  lastError   String?
  /// The last health verdict, and why. Separate from `state` because a
  /// server can be running and unhealthy, and the reason is the half an
  /// operator can act on.
  healthCheckedAt DateTime?
  healthDetail    String?
  /// When the game's console last said it was ready. Readiness happens
  /// once per run, and a busy server scrolls the line out of any window
  /// of recent output — so it is remembered, and only counts for a run
  /// that started before it.
  readyAt         DateTime?
  /// The timestamp of the last console line the poller read for player
  /// joins and leaves. Lines at or before it have been counted.
  logCursorAt     DateTime?
  /// The server directory's size on its node, as last measured, and when.
  /// Null until the poller has measured it once.
  worldSizeBytes  BigInt?
  worldSizeAt     DateTime?
  /// The build id this server was installed from, where its game has
  /// one. What makes an update detectable for a game with no version.
  installedBuildId String?

  /* ── Where an update came from ──────────────────────────────────
     Recorded when a server is updated, so going back is a button
     rather than a rescue. The backup is the one taken on the way, and
     keeping its id here is what stops a retention policy being the
     thing that decides whether a rollback is possible. */
  rollbackVersionId    String?
  rollbackVersionLabel String?
  rollbackBackupId     String?
  rollbackAt           DateTime?


  /* ── Crash recovery ─────────────────────────────────────────────
     `attempts` counts restarts since the server was last well, not
     since it was created — a server that crashes once a week must not
     eventually exhaust its budget and stay down. It is forgiven once
     the current run has lasted; see domain/servers/recovery.ts. */
  restartPolicy RestartPolicy @default(ON_FAILURE)
  maxRestarts   Int           @default(3)
  restartAttempts Int         @default(0)
  lastRestartAt   DateTime?
  crashCount      Int         @default(0)
  lastCrashAt     DateTime?
  lastExitCode    Int?
  oomKilled       Boolean     @default(false)
  startedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  nodeId  String
  node    Node   @relation(fields: [nodeId], references: [id])
  ownerId String
  owner   User   @relation("ServerOwner", fields: [ownerId], references: [id])

  /// Retiring a game must never delete the servers running it, so both
  /// of these fall back to null rather than cascading.
  gameRef        Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)
  gameVersionRef GameVersion? @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)

  backups Backup[]
  samples MetricSample[]
  events  ActivityEvent[]
  players PlayerSession[]
  tasks   ScheduledTask[]

  @@index([nodeId])
  @@index([gameId])
  /// Two servers on one node cannot hold the same port. The wizard
  /// picks a free one by looking, but looking and writing are not one
  /// step — this is what makes losing that race a failed insert to
  /// retry rather than two servers bound to the same address.
  @@unique([nodeId, port])
  @@map("servers")
}

/* One row per metric tick. The usage chart reads the last hour of
   these; retention prunes anything older than 30 days. */
model MetricSample {
  id       String   @id @default(cuid())
  serverId String
  at       DateTime @default(now())
  cpuPct   Int
  ramMb    Int
  players  Int
  tps      Float

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, at])
  @@map("metric_samples")
}

model Backup {
  id        String        @id @default(cuid())
  serverId  String
  name      String
  sizeBytes BigInt
  trigger   BackupTrigger @default(SCHEDULED)
  state     BackupState   @default(COMPLETE)
  keepUntil DateTime?
  /// sha256 of the archive, computed as it was written and checked
  /// again on restore. A backup nobody verified is a hope.
  checksum  String?
  /// Where the bytes are, and what the node calls them. Null on the
  /// records that predate real archives.
  store     BackupStore?
  artifact  String?
  /// How long the archive took, for an operator sizing a window.
  durationMs Int?
  /// Why a FAILED backup failed, as the node said it.
  error     String?
  createdAt DateTime      @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
  @@map("backups")
}

/// Where off-site backups go: one S3-compatible bucket for the
/// workspace. The keys are encrypted at rest like a node token and never
/// shown back; the panel signs short-lived URLs with them and a node
/// moves the bytes. One row, id "s3", or none.
model BackupStorage {
  id              String   @id @default("s3")
  endpoint        String
  region          String
  bucket          String
  /// A key prefix inside the bucket, so one bucket can serve several panels.
  prefix          String   @default("")
  pathStyle       Boolean  @default(true)
  accessKeyId     String
  /// Encrypted; see lib/secrets.ts.
  secretAccessKey String
  /// Scheduled backups go off-site rather than to the node's disk.
  scheduledOffsite Boolean @default(true)
  /// The last time the bucket answered a probe, and what it said if not.
  checkedAt       DateTime?
  checkError      String?
  configuredById  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("backup_storage")
}

model PlayerSession {
  id        String    @id @default(cuid())
  serverId  String
  username  String
  uuid      String
  pingMs    Int       @default(0)
  online    Boolean   @default(false)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  playtimeM Int       @default(0)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, online])
  @@map("player_sessions")
}

model ActivityEvent {
  id        String    @id @default(cuid())
  actor     String // display name, or a system actor like "Scheduler"
  action    String
  target    String?
  tone      EventTone @default(MUTED)
  ip        String?
  changes   Json?
  createdAt DateTime  @default(now())

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  serverId String?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("activity_events")
}

/* A cron-backed job against one server. `nextRunAt` is derived from
   the expression and stored so the list can be ordered by it. */
model ScheduledTask {
  id         String    @id @default(cuid())
  serverId   String
  name       String
  kind       TaskKind
  cron       String
  payload    String?
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  lastResult RunResult @default(NEVER_RUN)
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, enabled])
  @@map("scheduled_tasks")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String // shown in the UI: gbk_live_8f2a…d417
  hash       String // the secret is never stored in the clear
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}
