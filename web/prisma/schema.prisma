// Geeboard data model.
//
// The domain is: a Game has Versions; a Node is a machine that has been
// registered with the panel; a Server is one game server instance hosted
// on a Node and executed by a Runtime. Those are four different things
// and the schema keeps them that way — nothing here says "container",
// because which runtime a node uses is the node's business.
//
// The catalog tables (Game, GameVersion) are a projection of the game
// definitions in src/domain/games. The definitions are the source of
// truth; these rows exist so servers can point at a version and so the
// catalog can be queried, filtered and joined. `npm run games:sync`
// writes one from the other.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

/// The lifecycle of a game server, which is wider than the lifecycle of
/// whatever is executing it. INSTALLING and UPDATING are states only the
/// panel can know about; a runtime looking at the same server would just
/// see a workload that has not settled. See src/domain/servers/state.ts,
/// where the two views are reconciled.
enum ServerState {
  CREATING
  INSTALLING
  STARTING
  RUNNING
  UNHEALTHY
  STOPPING
  STOPPED
  RESTARTING
  UPDATING
  BACKING_UP
  /// Being moved to another node: stopped, archived off-site, restored there.
  MIGRATING
  DELETING
  CRASHED
  ERROR
  SUSPENDED
}

/// A node's health, and whether it is in service at all.
///
/// PENDING is the one that is not about health: a machine that has
/// registered itself and is waiting for somebody to say yes. Nothing is
/// placed on it and the watchdog leaves it alone until then, because a
/// node that registered with a stolen token must not become useful by
/// simply waiting.
enum NodeState {
  PENDING
  HEALTHY
  DEGRADED
  UNREACHABLE
  DRAINING
  MAINTENANCE
}

/// How a node executes the servers placed on it. One value today; the
/// column exists so that adding a second is a migration and not a
/// rewrite.
enum RuntimeKind {
  DOCKER
}

/// Where a version came from. STATIC is a version shipped in a game
/// definition; the rest are resolved from upstream by a provider.
enum VersionSource {
  STATIC
  STEAM
  GITHUB
  OFFICIAL
  REGISTRY
  MANUAL
}

enum VersionChannel {
  STABLE
  SNAPSHOT
  PREVIEW
  LEGACY
}

/// What to do when a server stops without being asked to.
///
/// Deliberately the panel's decision rather than the runtime's: a
/// container restarting behind the panel's back is the drift
/// reconciliation exists to catch, and a restart nobody can audit is a
/// restart nobody can explain.
enum RestartPolicy {
  NEVER
  ON_FAILURE
  ALWAYS
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
  PRE_UPDATE
  /// The last one, taken off-site as a server is deleted.
  PRE_DELETE
}

/// Where a backup's bytes live. Local means the node's own disk, which
/// is the one thing a node failure takes with it — hence the column,
/// so a second backend is a migration rather than a rewrite.
enum BackupStore {
  LOCAL
  S3
}

enum BackupState {
  RUNNING
  COMPLETE
  FAILED
  LOCKED
}

enum TaskKind {
  BACKUP
  RESTART
  BROADCAST
  CLEANUP
  COMMAND
  /// Re-reads the archives that are sitting there and marks the broken ones.
  VERIFY
}

enum RunResult {
  SUCCEEDED
  FAILED
  SKIPPED
  NEVER_RUN
}

enum EventTone {
  ACCENT
  INFO
  SUCCESS
  WARNING
  DANGER
  MUTED
}

model User {
  id                         String    @id @default(cuid())
  email                      String    @unique
  name                       String
  passwordHash               String
  role                       Role      @default(MEMBER)
  initials                   String    @db.VarChar(2)
  /// Two-factor sign-in is on: a TOTP code is asked for after the password.
  twoFactor                  Boolean   @default(false)
  /// The TOTP secret, encrypted at rest like a node token. Set while
  /// enrolment is in progress too, and only counts once twoFactor is on.
  totpSecret                 String?
  /// The 30-second step of the last code accepted, so a code is spent once.
  totpLastStep               Int?
  /// Null until the person has chosen a password themselves: an account
  /// made from the panel starts with one nobody knows and a setup link.
  passwordSetAt              DateTime?
  /// When a temporary password — made by `npm run setup` or the recovery
  /// command, shown once in a terminal — stops working. Null for every
  /// other account, and cleared when the person chooses their own.
  temporaryPasswordExpiresAt DateTime?
  lastSeenAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  sessions      Session[]
  servers       Server[]        @relation("ServerOwner")
  events        ActivityEvent[]
  apiKeys       ApiKey[]
  accountTokens AccountToken[]  @relation("AccountTokenUser")
  issuedTokens  AccountToken[]  @relation("AccountTokenIssuer")
  recoveryCodes RecoveryCode[]
  modsAdded     ServerMod[]     @relation("ModAddedBy")

  @@map("users")
}

/// Why a one-time link exists: to set the first password, or a new one.
enum AccountTokenPurpose {
  SETUP
  RESET
}

/// A one-time link to set a password. The panel sends no email, so the
/// link is shown once to the admin who made it and handed over by hand;
/// only its SHA-256 is kept. Spent atomically the moment it is used.
model AccountToken {
  id          String              @id @default(cuid())
  userId      String
  purpose     AccountTokenPurpose
  hash        String              @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime            @default(now())

  user      User  @relation("AccountTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AccountTokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("account_tokens")
}

/// A one-time way past two-factor when the authenticator is gone. Shown
/// once at enrolment, stored as SHA-256, each usable once.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  hash      String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/**
 * ── The game catalog ─────────────────────────────────────────────
 * A projection of src/domain/games, not a second source of truth. The
 * definitions decide what a game is; these rows make it queryable and
 * give a server something to point at that will still be there when a
 * definition is edited.
 */

model Game {
  /// Matches the definition's id: "minecraft-java".
  id          String    @id
  name        String
  /// What the panel groups by, and what Server.game has always held.
  family      String
  art         String
  blurb       String
  official    Boolean   @default(false)
  portBase    Int
  portSpan    Int
  /// Node capabilities this game needs before it can be placed.
  requires    String[]  @default([])
  memoryGbMin Int       @default(1)
  diskGbMin   Int       @default(1)
  /// Set when a definition is removed but servers still reference it.
  retiredAt   DateTime?
  syncedAt    DateTime  @default(now())

  versions GameVersion[]
  servers  Server[]

  @@index([family])
  @@map("games")
}

model GameVersion {
  id              String         @id @default(cuid())
  gameId          String
  /// Stable within the game: "paper-1-21-4".
  slug            String
  label           String
  /// The upstream version string, where the game has one: "1.4.4.9".
  upstream        String?
  /// What the runtime is asked to run. An image reference today.
  source          String
  note            String         @default("")
  channel         VersionChannel @default(STABLE)
  origin          VersionSource  @default(STATIC)
  /// Whether Geeboard will install it. A version can be listed and refused.
  supported       Boolean        @default(true)
  recommended     Boolean        @default(false)
  releasedAt      DateTime?
  checksum        String?
  /// Steam has no version numbers, only branches and build ids. A build
  /// id is not a version and is never compared against one — it belongs
  /// to its branch and answers a different question: has this moved?
  branch          String?
  buildId         String?
  branchUpdatedAt DateTime?
  syncedAt        DateTime       @default(now())

  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  servers Server[]

  @@unique([gameId, slug])
  @@index([gameId, supported])
  @@map("game_versions")
}

model Node {
  id            String      @id @default(cuid())
  name          String      @unique
  city          String
  region        String
  state         NodeState   @default(HEALTHY)
  pingMs        Int
  cpuPct        Int
  ramPct        Int
  diskPct       Int
  cpuCores      Int
  ramTotal      Int // GB
  diskTotal     Int // GB
  daemon        String
  /// The contract number the agent last reported: what it speaks to the panel, apart from which release it is.
  /// Null for an agent that sends none (every one up to 0.4.0), which is then judged by the release line in
  /// `daemon`. See domain/nodes/agent-version.ts.
  contract      Int?
  slots         Int         @default(9)
  /// How this node executes the servers placed on it.
  runtime       RuntimeKind @default(DOCKER)
  /// Reported by the node, not assumed. Null means it has not said yet,
  /// which the compatibility engine treats as unknown rather than wrong.
  os            String?
  arch          String?
  /// What this node can offer: docker, steamcmd, gpu, ipv6, ssd…
  capabilities  String[]    @default([])
  /// Last time the panel heard from the node at all — a successful poll
  /// or a heartbeat. What the Nodes page shows as "seen".
  lastSeenAt    DateTime?
  /// Last time the panel itself *reached* the node on its advertised
  /// address. The other direction, and the only one server placement
  /// uses — so it is what node health decays from; see docs/nodes.md.
  /// A heartbeat does not touch it: an agent that can call out says
  /// nothing about whether anything can call in.
  lastReachedAt DateTime?
  /// Why the panel could not reach the node the last time it tried, in
  /// the words the attempt failed with, or null once it got through. The
  /// heartbeat's call-back and the poller both write it, so the Add a
  /// node dialog and the node's page can say so instead of "never".
  reachDetail   String?
  /// When the node registered itself, and when somebody approved it.
  /// A node with no `approvedAt` takes no servers.
  registeredAt  DateTime?
  approvedAt    DateTime?
  approvedById  String?
  /// Base URL of the node agent, e.g. http://10.24.8.2:8080. Null means
  /// no agent is attached and lifecycle actions are simulated.
  daemonUrl     String?
  /// The agent's bearer token, encrypted at rest. The panel is the
  /// client, so it needs the plaintext back — this cannot be a hash.
  daemonToken   String?
  /// What the machine says about its node terminal, as the agent last
  /// reported it: `{ state, reason?, os, user, shell, scope }`. Null
  /// from an agent older than 0.3.5, which the panel reads as "too old"
  /// rather than as off. See docs/nodes.md, "Node terminal".
  terminal      Json?
  /// Where players reach this machine on the Internet, as a person set it
  /// on the node's page — an IPv4 or IPv6 literal. Null means nobody has
  /// said, and the address the panel observed is used if it is public.
  publicAddress   String?
  /// The same, for IPv6, when the machine has an address of that family the
  /// Internet can reach. A record in that family is written only for one a
  /// person set: the address the panel observed is a fallback for a node with
  /// neither set, and is never taken for the other family.
  publicAddress6  String?
  /// The address the last heartbeat came from, as the panel's proxy saw
  /// it. Used for DNS only when it is a public address: from the same
  /// LAN it is a private one, and the node's page says so.
  observedAddress String?
  observedAt      DateTime?
  createdAt     DateTime    @default(now())

  servers Server[]
  samples NodeSample[]

  @@map("nodes")
}

/// A single-use invitation for a machine to register itself.
///
/// The secret is shown once and stored as a bcrypt hash, like an API
/// key — a registration token is a credential that can bring a new
/// machine into the fleet, so it is treated like one. Short-lived,
/// single-use and revocable, because the failure mode of a leaked one
/// is somebody else's server appearing in your panel.
model NodeRegistrationToken {
  id         String    @id @default(cuid())
  /// Shown in the UI: gbn_8f2a…d417
  prefix     String
  hash       String
  /// What this token is for: "Milan rack 3".
  label      String
  /// The one node name this token may register. Null only on tokens
  /// minted before names were bound, which accept any name.
  nodeName   String?
  expiresAt  DateTime
  /// Set when a node consumes it. A token is good for exactly one node.
  usedAt     DateTime?
  usedByNode String?
  revokedAt  DateTime?

  createdById String
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("node_registration_tokens")
}

/// One game server instance. It is hosted on a Node and executed by that
/// node's Runtime — which is why `runtimeId` is opaque here: what it
/// identifies is the runtime's business, and the panel only has to be
/// able to hand it back.
model Server {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  /// The family, kept as text so a server survives its game definition
  /// being renamed or retired. `gameId` is the join; this is the label.
  game             String
  /// The version label, for the same reason.
  version          String
  art              String
  /// The catalog entry this server was created from. Null for servers
  /// that predate the catalog.
  gameId           String?
  gameVersionId    String?
  state            ServerState @default(STOPPED)
  playersOn        Int         @default(0)
  playersMax       Int
  cpuPct           Int         @default(0)
  ramPct           Int         @default(0)
  diskPct          Int         @default(0)
  /// The address players connect to: a DNS name, kept in lower case (a check
  /// constraint says so, since the name has no case) and unique — two servers
  /// on one name would fight over its record. Migration 20261001120000.
  host             String      @unique
  port             Int
  /// The update this server was last told about, so each is announced once: the
  /// target version's id, or the Steam build id for a game with no versions.
  updateNotifiedKey  String?
  memoryLimit      Int // GB
  cpuLimit         Int // percent of one core
  diskQuota        Int // GB
  /// How this server is executed, and the runtime's own handle for it.
  /// Opaque on purpose: today it is a container id, and nothing above
  /// the runtime should be written as though it always will be.
  runtime          RuntimeKind @default(DOCKER)
  runtimeId        String?
  /// Game settings, keyed by the definition's config field names —
  /// "maxPlayers", not "MAX_PLAYERS". Rendering them into whatever the
  /// game actually reads is src/domain/games/config.ts's job.
  config           Json?
  /// Why the server is in ERROR, when it is.
  lastError        String?
  /// Which long operation holds this server while one does (backup, restore, update, rollback, rebuild, settings, move), and who is running it:
  /// "<panel or poller>:<this process's id>". Written when the operation claims the server (lib/operations.ts), by one compare-and-set, so two
  /// that start together cannot both have it. The state says that an operation is running; these say which, whose, since when, and whether
  /// whoever runs it is still alive, which is how one that died is found and the server given back instead of "Updating" for ever.
  operation          String?
  operationOwner     String?
  operationStartedAt DateTime?
  /// The last time the process running it said it was alive: every thirty seconds while it holds the server.
  operationBeat      DateTime?
  /// What the server was before the operation, so that a backup that is cut short puts it back where it was.
  stateBefore        ServerState?
  /// The last health verdict, and why. Separate from `state` because a
  /// server can be running and unhealthy, and the reason is the half an
  /// operator can act on.
  healthCheckedAt  DateTime?
  healthDetail     String?
  /// When the game's console last said it was ready. Readiness happens
  /// once per run, and a busy server scrolls the line out of any window
  /// of recent output — so it is remembered, and only counts for a run
  /// that started before it.
  readyAt          DateTime?
  /// What the current workload was made from — see domain/games/workload.ts.
  /// Compared with what it would be made from today, which is how a
  /// definition that changed says "this server needs a rebuild". Null on a
  /// workload made before this was recorded: not known, so nothing is said.
  builtSpec        Json?
  /// Where an install has got to, while it is running: the step the
  /// installer last reported and its sentence. The key is one the
  /// creation wizard — or the update, rollback and rebuild buttons — made
  /// up, so it can ask about a server whose address it does not know yet.
  /// All four are cleared when the install ends.
  installKey       String?     @unique
  installStep      String?
  installMessage   String?
  /// While downloading: the layers and bytes the node counted, so the
  /// person waiting sees a real bar rather than a sentence alone.
  installDetail    Json?
  /// The timestamp of the last console line the poller read for player
  /// joins and leaves. Lines at or before it have been counted.
  logCursorAt      DateTime?
  /// The server directory's size on its node, as last measured, and when.
  /// Null until the poller has measured it once.
  worldSizeBytes   BigInt?
  worldSizeAt      DateTime?
  /// The build id this server was installed from, where its game has
  /// one. What makes an update detectable for a game with no version.
  installedBuildId String?

  /**
   * ── Where an update came from ──────────────────────────────────
   * Recorded when a server is updated, so going back is a button
   * rather than a rescue. The backup is the one taken on the way, and
   * keeping its id here is what stops a retention policy being the
   * thing that decides whether a rollback is possible.
   */
  rollbackVersionId    String?
  rollbackVersionLabel String?
  rollbackBackupId     String?
  rollbackAt           DateTime?

  /**
   * ── Crash recovery ─────────────────────────────────────────────
   * `attempts` counts restarts since the server was last well, not
   * since it was created — a server that crashes once a week must not
   * eventually exhaust its budget and stay down. It is forgiven once
   * the current run has lasted; see domain/servers/recovery.ts.
   */
  restartPolicy   RestartPolicy @default(ON_FAILURE)
  maxRestarts     Int           @default(3)
  restartAttempts Int           @default(0)
  lastRestartAt   DateTime?
  crashCount      Int           @default(0)
  lastCrashAt     DateTime?
  lastExitCode    Int?
  oomKilled       Boolean       @default(false)
  startedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  nodeId  String
  node    Node   @relation(fields: [nodeId], references: [id])
  ownerId String
  owner   User   @relation("ServerOwner", fields: [ownerId], references: [id])

  /// Retiring a game must never delete the servers running it, so both
  /// of these fall back to null rather than cascading.
  gameRef        Game?        @relation(fields: [gameId], references: [id], onDelete: SetNull)
  gameVersionRef GameVersion? @relation(fields: [gameVersionId], references: [id], onDelete: SetNull)

  /// What was last written into the game's own settings as its mods: the
  /// Workshop ids it downloads and the mod ids it loads. Kept so the
  /// panel can say "chosen, not applied yet" without reading a file off
  /// the node on every page — and say it truthfully.
  modItemsApplied String[] @default([])
  modIdsApplied   String[] @default([])

  backups Backup[]
  samples MetricSample[]
  events  ActivityEvent[]
  players PlayerSession[]
  tasks   ScheduledTask[]
  mods    ServerMod[]
  /// The DNS records the panel keeps for `host`, when a provider is configured
  /// and the host is under its zone. See docs/servers.md, "DNS".
  dnsRecords ServerDnsRecord[]

  /// The network counters as last read, and the start of the run they belong to: what the next
  /// sample's difference is taken against. Docker's counters start again when a container does, so
  /// a reading from another run is not subtracted from. Null before the first reading of a run.
  netRx        BigInt?
  netTx        BigInt?
  netStartedAt DateTime?

  /// Two servers on one node cannot hold the same port. The wizard
  /// picks a free one by looking, but looking and writing are not one
  /// step — this is what makes losing that race a failed insert to
  /// retry rather than two servers bound to the same address.
  @@unique([nodeId, port])
  @@index([nodeId])
  @@index([gameId])
  @@map("servers")
}

/// A DNS record the panel keeps for a server: one row for each kind it has
/// written or tried to (A, AAAA, SRV). Before 0.7.0 a server had one address
/// record in four columns of its own; a record of each kind, and the name each
/// is at, are what lets a server have an IPv4 and an IPv6 address and an SRV
/// record, and be removed from where it was when its host changes.
model ServerDnsRecord {
  id               String    @id @default(cuid())
  serverId         String
  /// "A", "AAAA" or "SRV".
  kind             String
  /// Where the record is at the provider: the server's host, or
  /// `_minecraft._tcp.<host>` for the SRV. Kept, so a record can be taken
  /// away from the name it was written at after the host changed.
  name             String
  /// The provider's id for it (Cloudflare; DuckDNS has none).
  providerRecordId String?
  /// What was last written: an address, or for SRV `priority weight port target`.
  /// Null when nothing has been written yet and the first try failed.
  content          String?
  /// When the panel last tried, and why the last try failed. Null when it has not.
  checkedAt        DateTime?
  error            String?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, kind])
  @@map("server_dns_records")
}

/**
 * One row per metric tick. The usage chart reads the last hour of
 * these; retention prunes anything older than 30 days.
 */
model MetricSample {
  id       String   @id @default(cuid())
  serverId String
  at       DateTime @default(now())
  cpuPct   Int
  ramMb    Int
  players  Int
  /// Bytes received and sent since the sample before this one, summed over the container's
  /// interfaces. Docker's counters are cumulative from the container's start and begin again at
  /// every restart, so these are differences with that rule applied (domain/servers/network.ts);
  /// null on the first sample of a run, and on every sample from before 0.7.0.
  rxBytes  BigInt?
  txBytes  BigInt?
  /// The size of the world as last measured, which is every five minutes: the same value on the
  /// samples between. Null before the first measurement and before 0.7.0.
  diskBytes BigInt?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, at])
  /// The prune deletes by age alone ("at" is not the leading column of the index above), and read the whole table to do it.
  @@index([at])
  @@map("metric_samples")
}

/**
 * One row per heartbeat of a node: what the node reported about itself, kept for 30 days like a server's
 * samples. The node's page draws its history from these; until 0.7.0 a node kept only the last values.
 */
model NodeSample {
  id      String   @id @default(cuid())
  nodeId  String
  at      DateTime @default(now())
  cpuPct  Int
  ramPct  Int
  diskPct Int
  /// The panel's round trip to the agent as last measured, in milliseconds.
  pingMs  Int

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, at])
  @@index([at])
  @@map("node_samples")
}

/**
 * What the watchdog last did: one row, `id` 1, upserted at the end of every poller pass that finished. The panel's dashboard and Nodes
 * page read it to say "last pass 6 s ago" and to warn when it is older than three intervals, and the poller container's healthcheck reads
 * it to say unhealthy: a poller that is stuck, or gone, is otherwise invisible, because nothing it does not do leaves a trace.
 */
model PollerState {
  id            Int       @id @default(1)
  /// When the last pass finished. Null on a poller that has started and not finished one yet.
  lastPassAt    DateTime?
  /// How long that pass took, in milliseconds.
  lastPassMs    Int?
  servers       Int       @default(0)
  nodes         Int       @default(0)
  /// Problems the pass reported (an unreachable node, a failed restart), not exceptions: a pass that threw is not recorded.
  errors        Int       @default(0)
  /// When the pass that is running began: later than lastPassAt while one is. A long scheduled backup runs inside a pass, and until it
  /// ends nothing is watched, which "last pass 8 min ago" alone does not say the cause of.
  passStartedAt DateTime?
  /// The poller's release, which differs from the panel's when one was upgraded and the other not.
  version       String
  /// How often it means to pass, so that "late" is judged against what the poller itself was told, not against this process's own setting.
  intervalMs    Int
  startedAt     DateTime
  /// When it last pruned old rows. The prune runs from the clock, so a poller that restarts more often than hourly still does it.
  lastPruneAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("poller_state")
}

model Backup {
  id               String        @id @default(cuid())
  /// Null once the server is deleted. An off-site archive outlives its
  /// server — that is what off-site is for — so its row does too, and
  /// the `origin*` columns below say what it was a backup of. A local
  /// archive goes with the server's disk, and its row with it.
  serverId         String?
  name             String
  sizeBytes        BigInt
  trigger          BackupTrigger @default(SCHEDULED)
  state            BackupState   @default(COMPLETE)
  keepUntil        DateTime?
  /// sha256 of the archive, computed as it was written and checked
  /// again on restore. A backup nobody verified is a hope.
  checksum         String?
  /// Where the bytes are, and what the node calls them. Null on the
  /// records that predate real archives.
  store            BackupStore?
  artifact         String?
  /// How long the archive took, for an operator sizing a window.
  durationMs       Int?
  /// Why a FAILED backup failed, as the node said it.
  error            String?
  /// When the archive was last read back where it lies and compared with
  /// `checksum`. Null means nobody has looked since it was written.
  verifiedAt       DateTime?
  /// What that look found wrong — a different digest, a different size,
  /// no archive at all. Null after a look means it matched. Beside
  /// `state` rather than in it: a locked backup can be damaged too, and
  /// that is the one an operator most needs told about.
  verifyError      String?
  /// Written when the server is deleted, never before. The id is the one
  /// the object's key was built from, so the archive can still be found;
  /// the game is what decides which server it may be restored into; the
  /// owner is whose permission still applies to it.
  originServerId   String?
  originServerName String?
  originGameId     String?
  originOwnerId    String?
  createdAt        DateTime      @default(now())

  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([serverId, createdAt])
  @@map("backups")
}

/// Where off-site backups go: one S3-compatible bucket for the
/// workspace. The keys are encrypted at rest like a node token and never
/// shown back; the panel signs short-lived URLs with them and a node
/// moves the bytes. One row, id "s3", or none.
model BackupStorage {
  id               String    @id @default("s3")
  endpoint         String
  region           String
  bucket           String
  /// A key prefix inside the bucket, so one bucket can serve several panels.
  prefix           String    @default("")
  pathStyle        Boolean   @default(true)
  accessKeyId      String
  /// Encrypted; see lib/secrets.ts.
  secretAccessKey  String
  /// Scheduled backups go off-site rather than to the node's disk.
  scheduledOffsite Boolean   @default(true)
  /// The last time the bucket answered a probe, and what it said if not.
  checkedAt        DateTime?
  checkError       String?
  configuredById   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("backup_storage")
}

/// The DNS provider the panel writes game servers' records to, when one
/// is configured. One row or none: with none, a server's address is a
/// hostname somebody points at the node themselves, as it always was.
/// See lib/dns-ops.ts and docs/servers.md, "DNS".
model DnsProvider {
  id             String    @id @default("dns")
  /// "cloudflare", "duckdns" or "webhook"; the facts of each are DNS_PROVIDERS in domain/dns/rules.ts.
  kind           String
  /// Encrypted; see lib/secrets.ts. For a webhook, the secret its requests are signed with.
  token          String
  /// A webhook's address, encrypted like the token: it may hold a secret in its path. Null for any other kind.
  endpoint       String?
  /// The zone records are written under: a Cloudflare zone's name, a webhook's
  /// domain, or "duckdns.org". A server's host has to end in it to get a record.
  zone           String
  /// Cloudflare's id for the zone, looked up when the token was checked.
  zoneId         String?
  /// DuckDNS: one of the account's subdomains, which the check updates in place.
  checkHost      String?
  /// The last time the provider accepted the token, and what it said if not.
  checkedAt      DateTime?
  checkError     String?
  configuredById String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("dns_provider")
}

/// The Steam Web API key, when it was set from the panel. One row or none.
/// Searching the Workshop is the only thing that needs it, and
/// STEAM_API_KEY in the environment outranks it; see lib/steam-ops.ts.
/// Where the panel sends a notification. Each one is an address somebody
/// pasted, which the panel calls from inside its own network, so it is held
/// like a key: encrypted, never shown again, in no API scope, and judged
/// again every time before it is called (domain/notify/destination.ts).
model NotificationChannel {
  id            String    @id @default(cuid())
  name          String    @unique
  /// "DISCORD" or "WEBHOOK".
  kind          String
  /// Encrypted; see lib/secrets.ts. A Discord webhook's address holds its token.
  url           String
  /// Encrypted. The key a webhook's body is signed with, shown once when the
  /// channel is made. Null for Discord, which has its own way of knowing.
  signingSecret String?
  /// The events this channel wants, by name ("server.crashed", ...).
  events        String[]
  enabled       Boolean   @default(true)
  /// The last delivery that got through, and the last that did not, with why.
  lastOkAt      DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deliveries NotificationDelivery[]

  @@map("notification_channels")
}

enum DeliveryState {
  PENDING
  SENT
  /// Given up on: out of attempts, or too old to be worth sending.
  FAILED
}

/// One message to one channel. Made when an event is read and kept until it
/// has been sent or given up on, so a retry sends what was meant and not what
/// the panel's rows have since become.
model NotificationDelivery {
  id            String              @id @default(cuid())
  channelId     String
  channel       NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// The kind of the message: "server.crashed", "node.unreachable", ...
  kind          String
  /// The message as built (domain/notify/rules.ts). Never an address or a token.
  payload       Json
  state         DeliveryState       @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  lastError     String?
  createdAt     DateTime            @default(now())
  sentAt        DateTime?

  @@index([state, nextAttemptAt])
  @@index([channelId, createdAt])
  @@map("notification_deliveries")
}

/// How far into the audit log the dispatcher has read. One row or none.
model NotificationCursor {
  id          String   @id @default("events")
  lastEventAt DateTime
  lastEventId String?
  updatedAt   DateTime @updatedAt

  @@map("notification_cursor")
}

/// A starting point for a new server that somebody saved from one that exists:
/// its settings (without the ones marked secret, and without a file in its own
/// folder), its limits and its version. A built-in template is a definition in
/// the code; this is the workspace's own.
model ServerTemplate {
  id           String   @id @default(cuid())
  name         String
  gameId       String
  /// Domain config keys and their values.
  config       Json
  memoryGb     Int
  cpuLimit     Int
  diskGb       Int
  /// The version it was saved at, as text: a version that is retired is a label, not a link.
  versionLabel String?
  /// The version's id in the game's definition, to select it again.
  versionSlug  String?
  /// The server it was saved from, by name, for the list.
  sourceName   String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@unique([gameId, name])
  @@map("server_templates")
}

enum ManifestState {
  /// Proposed and read by nobody yet. Runs nothing, and is in no wizard.
  PENDING
  /// An owner read what it would run and said yes. At most one per game.
  APPROVED
  REJECTED
  /// A newer revision of the game was approved.
  SUPERSEDED
  /// An owner or admin took the game out of the wizard. Its servers go on.
  RETIRED
}

/// One revision of a game that somebody wrote: a manifest pasted by an owner
/// or admin, and what became of it. The manifest is kept as it was given and
/// its hash is what an approval is bound to; a row whose manifest no longer
/// hashes to `hash` is not loaded (lib/community-games.ts).
model GameManifest {
  id            String        @id @default(cuid())
  /// "community-factorio": the manifest's own id, with its prefix.
  gameId        String
  revision      Int
  /// The manifest as it was given: the parsed JSON that was hashed.
  manifest      Json
  /// SHA-256, hex, of the canonical form of `manifest`.
  hash          String
  /// The definition the manifest last validated into, as it was then. A rule added to the validator after an owner approved a game must not
  /// take the game out of the registry under its servers (stopped by signal, backed up unflushed, never judged, told it "predates the
  /// catalog"): when the manifest no longer passes the current checks, this is what is served, flagged, and not offered for new servers.
  /// Null until the first load that saw it pass.
  definition    Json?
  state         ManifestState @default(PENDING)
  /// The game's name, for lists, so they need not read the manifest.
  name          String
  submittedById String?
  submittedAt   DateTime      @default(now())
  reviewedById  String?
  reviewedAt    DateTime?
  note          String?

  @@unique([gameId, revision])
  @@index([state])
  @@map("game_manifests")
}

/// The workspace's rules for games that came from a manifest. One row or none.
model CommunityPolicy {
  id          String   @id @default("policy")
  /// Registries an image in a manifest may come from. Empty is "none": nothing can be proposed.
  registries  String[]
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("community_policy")
}

model WorkshopKey {
  id             String    @id @default("steam")
  /// Encrypted; see lib/secrets.ts.
  apiKey         String
  /// The last time Steam accepted the key, and what it said if not.
  checkedAt      DateTime?
  checkError     String?
  configuredById String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("workshop_key")
}

model PlayerSession {
  id        String    @id @default(cuid())
  serverId  String
  username  String
  uuid      String
  pingMs    Int       @default(0)
  online    Boolean   @default(false)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  playtimeM Int       @default(0)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, online])
  @@map("player_sessions")
}

model ActivityEvent {
  id        String    @id @default(cuid())
  actor     String // display name, or a system actor like "Scheduler"
  action    String
  target    String?
  tone      EventTone @default(MUTED)
  ip        String?
  changes   Json?
  createdAt DateTime  @default(now())

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Null once the server is deleted. The log is the record of what was
  /// done, and it used to go with the server — every setting changed,
  /// every command typed, every mod applied — leaving only the line that
  /// said it had been deleted. The `originServer*` columns below say
  /// which server an event was about after the link is gone.
  serverId String?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  /// Written when the server is deleted, never before, as on a backup
  /// that outlives its server: until then the link answers, and a rename
  /// shows everywhere at once.
  originServerId   String?
  originServerName String?
  originServerSlug String?

  @@index([createdAt])
  @@index([serverId])
  @@map("activity_events")
}

/**
 * A cron-backed job against one server. `nextRunAt` is derived from
 * the expression and stored so the list can be ordered by it.
 */
model ScheduledTask {
  id         String    @id @default(cuid())
  serverId   String
  name       String
  kind       TaskKind
  cron       String
  payload    String?
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  lastResult RunResult @default(NEVER_RUN)
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, enabled])
  @@map("scheduled_tasks")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String // shown in the UI: gbk_live_8f2a…d417
  hash       String // the secret is never stored in the clear
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

/// A mod on a server: one Steam Workshop item, and what the panel knows
/// about it. The panel never holds a mod's bytes — the game downloads
/// them on the node from the ids it is told — so this row is the choice
/// somebody made and the answer the node gave back, nothing more.
model ServerMod {
  id       String @id @default(cuid())
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  /// The Workshop item's id: what the game is told to download.
  workshopId String
  /// What Steam called it when it was added, so the panel can name it
  /// with the network gone or the item taken down.
  title      String
  /// The item's preview image on Steam's CDN, for the browser to fetch.
  /// Null when Steam did not give one.
  previewUrl String?
  /// Bytes, as Steam reported them when it was added. Zero when unknown.
  sizeBytes  Int     @default(0)

  /// The mod ids inside the download — read off the node from each
  /// mod.info after the game fetched it, never guessed here. Empty until
  /// the server has started once with this item listed.
  modIds   String[] @default([])
  /// What the node found in the download, as it said it: each mod's
  /// directory, the folders in it and every mod.info with the versions it
  /// declares. Which of those a build loads is decided against the
  /// server's version whenever it is read (domain/games/mod-builds.ts),
  /// so an update that moves the game is judged without asking the node
  /// again. Null until the node has answered — and for an answer from an
  /// agent before 0.3.0, which reported ids alone.
  contents Json?
  /// Whether its mod ids are written into the game's load list. An item
  /// can be downloaded and not loaded, which is how a mod is turned off
  /// without losing which one it was.
  enabled  Boolean  @default(true)
  /// Load order, which for Zomboid decides who wins a conflict.
  position Int

  /// The Workshop collection that added it, and that collection's title
  /// then — so what a collection brought can be taken away as one. A
  /// collection adds three hundred rows in one click, and they used to
  /// leave in three hundred. Null for a mod added on its own, and for one
  /// added before this was kept until its collection is pasted again.
  collectionId    String?
  collectionTitle String?

  /// The Workshop items its page lists as required, as `[{ id, title }]`,
  /// asked of Steam when it was added or when the node was last asked.
  /// Null when that is not known, which is every mod on an installation
  /// with no Steam key: only the keyed API answers it.
  requires Json?

  addedAt   DateTime @default(now())
  addedById String?
  addedBy   User?    @relation("ModAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([serverId, workshopId])
  @@index([serverId])
  @@map("server_mods")
}

/// What the panel last learned about newer releases of itself: one row, rewritten by the poller at most twice a day from the release.json that
/// every release carries (domain/updates/release.ts). A page reads this row and never asks GitHub.
model UpdateCheck {
  id          String    @id @default("panel")
  /// The last attempt, whether it reached an answer or not: what the next one waits twelve hours from.
  checkedAt   DateTime?
  /// The last attempt that read a release file.
  succeededAt DateTime?
  /// What the next request says it already has, so an unchanged file costs a 304.
  etag        String?
  /// Why the last attempt failed, in a sentence; null after one that worked.
  error       String?
  /// The release file as it was read and validated (domain/updates/release.ts), or null before the first one.
  release     Json?
  /// "<version>:<state>" of the audit line last written for it, so a release that stays out is announced once.
  notifiedKey String?
  updatedAt   DateTime  @updatedAt

  @@map("update_checks")
}
